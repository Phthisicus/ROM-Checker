{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "json", "path": "web/client/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/client/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/client/package-lock.json", "jsonpath": "$.packages[''].version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "New features" },
        { "type": "fix", "section": "Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Maintenance" },
        { "type": "chore", "section": "Maintenance" }
      ]
    }
  }
}
