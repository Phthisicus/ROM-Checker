# Copy to .env.romm; never commit populated environment files.
# Keep both Compose files together. Use a NEW directory/project for a new stack.
ROM_LIBRARY=/absolute/path/to/romchecker-server-library
ROMCHECKER_PASSWORD=
ROMCHECKER_STORAGE_TOKEN=
ROMCHECKER_IMAGE=ghcr.io/phthisicus/rom-checker:beta
ROMCHECKER_PORT=8080
ROMCHECKER_ALLOWED_HOSTS=localhost;127.0.0.1
ROMCHECKER_PATH_BASE=
ROMCHECKER_TRUSTED_PROXIES=
ROMCHECKER_SMB_HOSTS=
ROMCHECKER_STORAGE_MAX_BYTES=1099511627776
ROMCHECKER_STORAGE_MAX_FILES=100000
ROMCHECKER_STORAGE_RESERVE_BYTES=1073741824
ROMSORTER_VIRUSTOTAL_KEY=
ROMSORTER_MALWAREBAZAAR_KEY=
# Optional channel-aware notifications; never installs updates.
ROMCHECKER_CHECK_UPDATES=false
ROMCHECKER_SCHEDULED_UPDATES=false
ROMCHECKER_UPDATE_USERNAME=
ROMCHECKER_UPDATE_TOKEN=

# Dedicated export directory, NOT ROM_LIBRARY or the managed storage root.
# Create it first and grant ROM Checker UID/GID 10001:10001 write permission.
ROMM_LIBRARY=/absolute/path/to/romm-export
ROMM_IMAGE=rommapp/romm:5.4.1
ROMM_PORT=8081
# Generate each secret separately, for example: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
# Optional RomM metadata providers; consult RomM's provider documentation.
ROMM_HASHEOUS_API_ENABLED=false
ROMM_IGDB_CLIENT_ID=
ROMM_IGDB_CLIENT_SECRET=
ROMM_STEAMGRIDDB_API_KEY=
# Create the RomM API token in its UI AFTER first boot, then save it in
# ROM Checker > Settings > Connections > RomM. It does not belong in this file.
