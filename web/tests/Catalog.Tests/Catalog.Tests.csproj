<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Compile Include="..\..\server\Features\Catalog\*.cs" Link="Catalog\%(Filename)%(Extension)" />
    <Compile Include="..\..\server\Models.cs" Link="Backend\Models.cs" />
    <Compile Include="..\..\server\Store.cs" Link="Backend\Store.cs" />
    <Compile Include="..\..\server\JobService.cs" Link="Backend\JobService.cs" />
    <Compile Include="..\..\server\Infrastructure\EngineRunner.cs" Link="Backend\EngineRunner.cs" />
    <Compile Include="..\..\server\Features\Storage\StorageClient.cs" Link="Backend\StorageClient.cs" />
    <Compile Include="..\..\server\Features\Storage\StorageModels.cs" Link="Backend\StorageModels.cs" />
    <Compile Include="..\..\server\Features\Storage\StoragePaths.cs" Link="Backend\StoragePaths.cs" />
    <Compile Include="..\..\server\Features\Library\LibraryPaths.cs" Link="Backend\LibraryPaths.cs" />
    <Compile Include="..\..\server\Features\Settings\SettingsValidator.cs" Link="Backend\SettingsValidator.cs" />
    <Compile Include="..\..\server\Features\Jobs\JobActions.cs" Link="Backend\JobActions.cs" />
  </ItemGroup>
</Project>
