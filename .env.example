# Copy to .env and supply your own values. Never commit .env.
ROM_LIBRARY=/absolute/path/to/roms
ROMCHECKER_PASSWORD=
# Generate a separate random secret, at least 32 characters. Used only between app and storage.
ROMCHECKER_STORAGE_TOKEN=
# Exact SMB hostnames or IP addresses approved for GUI connections (comma-separated).
ROMCHECKER_SMB_HOSTS=
# Per-batch limits and minimum free disk space. Originals plus processing copies need extra space.
ROMCHECKER_STORAGE_MAX_BYTES=1099511627776
ROMCHECKER_STORAGE_MAX_FILES=100000
ROMCHECKER_STORAGE_RESERVE_BYTES=1073741824
ROMCHECKER_PORT=8080
ROMCHECKER_IMAGE=ghcr.io/phthisicus/rom-checker:beta
# Empty for a dedicated hostname; /romchecker for a subpath.
ROMCHECKER_PATH_BASE=
# Exact source IP of the proxy as seen INSIDE the application container.
# Do not use a wildcard or an entire untrusted network.
ROMCHECKER_TRUSTED_PROXIES=
# Semicolon-separated public and healthcheck hostnames, without scheme/port.
ROMCHECKER_ALLOWED_HOSTS=localhost;127.0.0.1;roms.example.com
ROMSORTER_VIRUSTOTAL_KEY=
ROMSORTER_MALWAREBAZAAR_KEY=
# Optional manual update notifications; no automatic deployment or background polling.
ROMCHECKER_CHECK_UPDATES=false
# Private GHCR package-read credentials, used only by the application server.
ROMCHECKER_UPDATE_USERNAME=
ROMCHECKER_UPDATE_TOKEN=
